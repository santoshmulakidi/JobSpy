{
  "name": "local-windows-ai-copilot",
  "private": true,
  "version": "0.1.0",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "test": "vitest run",
    "test:electron-audio": "vite build --config vite.utility.config.ts --outDir .vite/build --emptyOutDir false && electron tests/electron/audio-utility-harness.cjs",
    "test:electron-audio:packaged": "electron tests/electron/audio-utility-harness.cjs packaged",
    "typecheck": "tsc --noEmit",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@types/node": "22.15.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "43.0.0",
    "playwright": "1.57.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
